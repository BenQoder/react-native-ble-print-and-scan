{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "bleprintandscan"
  ],
  "ios": {
    "iosModuleName": "BlePrintAndScan"
  },
  "android": {
    "androidNamespace": [
      "bleprintandscan"
    ],
    "androidCxxLibName": "BlePrintAndScan"
  },
  "autolinking": {
    "BlePrinter": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridBlePrinter"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridBlePrinter"
      }
    },
    "BleScanner": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridBleScanner"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridBleScanner"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
